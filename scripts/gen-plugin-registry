#!/bin/sh
# Writes plugin_registry.go: every shell plugin in the pinned version of
# github.com/1Password/shell-plugins. (Upstream generates an equivalent list
# with `make registry` but doesn't check it in.)
set -eu
cd "$(dirname "$0")/.."
names=$(cd "$(go list -m -f '{{.Dir}}' github.com/1Password/shell-plugins)/plugins" && ls */plugin.go | xargs -n1 dirname)
{
	echo '// Code generated by scripts/gen-plugin-registry. DO NOT EDIT.'
	echo
	echo 'package main'
	echo
	echo 'import ('
	for n in $names; do echo "	\"github.com/1Password/shell-plugins/plugins/$n\""; done
	echo '	"github.com/1Password/shell-plugins/sdk/schema"'
	echo ')'
	echo
	echo 'func shellPlugins() []schema.Plugin {'
	echo '	return []schema.Plugin{'
	for n in $names; do echo "		$n.New(),"; done
	echo '	}'
	echo '}'
} > plugin_registry.go
gofmt -l plugin_registry.go
